{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "customer": {
      "root": "customer",
      "framework": "vite",
      "buildCommand": "npm run build",
      "outputDirectory": "build",
      "rewrites": [
        {
          "source": "/(.*)",
          "destination": "/index.html"
        }
      ]
    },
    "admin": {
      "root": "admin",
      "framework": "vite",
      "buildCommand": "npm run build",
      "outputDirectory": "build",
      "rewrites": [
        {
          "source": "/(.*)",
          "destination": "/index.html"
        }
      ]
    },
    "merchant": {
      "root": "merchant",
      "framework": "vite",
      "buildCommand": "npm run build",
      "outputDirectory": "build",
      "rewrites": [
        {
          "source": "/(.*)",
          "destination": "/index.html"
        }
      ]
    },
    "driver": {
      "root": "driver",
      "framework": "vite",
      "buildCommand": "npm run build",
      "outputDirectory": "build",
      "rewrites": [
        {
          "source": "/(.*)",
          "destination": "/index.html"
        }
      ]
    }
  },
  "redirects": [
    {
      "source": "/admin",
      "destination": "/admin/",
      "permanent": false
    },
    {
      "source": "/merchant",
      "destination": "/merchant/",
      "permanent": false
    },
    {
      "source": "/driver",
      "destination": "/driver/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://foodie-backend-mu.vercel.app/api/:path*"
    },
    {
      "source": "/admin/:path*",
      "destination": {
        "service": "admin",
        "path": "/:path*"
      }
    },
    {
      "source": "/merchant/:path*",
      "destination": {
        "service": "merchant",
        "path": "/:path*"
      }
    },
    {
      "source": "/driver/:path*",
      "destination": {
        "service": "driver",
        "path": "/:path*"
      }
    },
    {
      "source": "/:path*",
      "destination": {
        "service": "customer",
        "path": "/:path*"
      }
    }
  ]
}